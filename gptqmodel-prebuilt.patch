+    def _packaged_prebuilt_library(self) -> Optional[Path]:
+        """Return the ops library shipped inside the package, when present.
+
+        Distribution builds that can run a CUDA toolchain may precompile an
+        extension and drop `<name>.so` into `gptqmodel_ext/prebuilt`, which then
+        needs neither nvcc nor a writable package directory at run time.
+        """
+
+        candidate = (
+            Path(__file__).resolve().parents[2]
+            / "gptqmodel_ext"
+            / "prebuilt"
+            / f"{self.name}.so"
+        )
+        return candidate if candidate.is_file() else None
